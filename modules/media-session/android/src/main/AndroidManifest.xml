<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Holding notification access is what lets us read other apps' media sessions. -->
    <service
      android:name="expo.modules.mediasession.MediaListenerService"
      android:exported="true"
      android:label="KaraokeFlow"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Android Auto binds this to show lyrics on the car screen as a media app. -->
    <service
      android:name="expo.modules.mediasession.CarMediaService"
      android:exported="true"
      android:label="KaraokeFlow">
      <intent-filter>
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>

    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />
  </application>
</manifest>
